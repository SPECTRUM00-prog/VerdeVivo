<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LuzActivity">

    <LinearLayout
        android:id="@+id/layoutLuz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EDF7EE"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloLuz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medidor de Luz para Plantas"
            android:textAlignment="center"
            android:textColor="#1B5E20"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvValorLuz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="0 lx"
            android:textColor="#2E7D32"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConsejoLuz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Coloca el teléfono junto a tu planta"
            android:textColor="#1B5E20"
            android:textSize="18sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>